# Application Config
PORT=3000
NODE_ENV=production
API_BASE_URL=https://api.rajaemas.id

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin_listening
DB_PASSWORD=your_database_password
DB_NAME=rei_listening
DB_CONNECTION_LIMIT=10

# Apify Configuration
APIFY_TOKEN=your_apify_token_here
APIFY_ACTOR=trendsmcp/social-listening-mcp

# Optional TrendsMCP API Key (from trendsmcp.ai)
TRENDS_API_KEY=

# Brand Target Configuration
BRAND_NAME=Raja Emas Indonesia
BRAND_KEYWORDS="Raja Emas Indonesia, raja emas, rajaemas"

# Cron Schedule
CRON_SCHEDULE="0 */6 * * *"
